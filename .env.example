APP_NAME=Grad Student Task Manager

# Marginalia website connection. Copy this file to .env and fill it in. Never commit .env.
# URL and anon key: Supabase dashboard -> Project Settings -> API (both are safe to share).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The same email and password you sign in to the website with. Do NOT use the service_role key.
SUPABASE_EMAIL=you@example.com
SUPABASE_PASSWORD=your-website-password
